{
language = ENG;
value = "Autour is inspired by handwritten letters on Ludwig Hohlwein posters. It has been changed and adapted from the originals in a variety of ways so that it will work in paragraphs of text and as a web type. Autour can be used a in a wide range of sizes. Autour means \"round\" in French.";
}
